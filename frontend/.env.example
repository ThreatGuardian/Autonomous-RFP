# Copy to frontend/.env.local to enable "Continue with Google" (and SSO).
# Values come from Firebase console → Project settings → Your apps → Web app config.
# These identify the Firebase project; they are not secrets, but keep .env.local out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: provider id of a SAML or OIDC provider added in Firebase (e.g. saml.acme or oidc.acme)
VITE_FIREBASE_SSO_PROVIDER=
