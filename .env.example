# Copy this file to .env (next to run.sh) and fill in what you use.
# run.sh / run.ps1 load it automatically. Never commit .env — it holds secrets.
# Step-by-step instructions for every key: docs/SETUP.md

# ---------------------------------------------------------------- language-model agents
# Provider: nvidia (Nemotron 3.5 Lightning via NVIDIA's API) | anthropic (Claude) | openai_compatible (own vLLM/Ollama server)
TD_LLM_PROVIDER=nvidia
# From https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b → Get API Key (starts with nvapi-)
NVIDIA_API_KEY=
# From https://console.anthropic.com → API keys (only for TD_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# auto (use the model when the provider's key is set) | on | off. Without a key the agents run on rules only.
TD_LLM=auto
# Defaults per provider; override only if needed.
# TD_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# TD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# TD_LLM_API_KEY=        # key for an openai_compatible server, if it needs one

# ---------------------------------------------------------------- sign-in
# development (default) | production. Production requires TD_SECRET_KEY and a non-demo
# TD_MARKET_API_KEY, sends cookies over HTTPS only and turns off open sign-up.
TD_ENV=development
# Random value of at least 32 characters; generated into the var folder if empty (development).
# python -c "import secrets; print(secrets.token_hex(32))"
TD_SECRET_KEY=
# Allow anyone who can reach the server to create an account (default 1 in development).
# TD_ALLOW_SIGNUP=1
# Create the demo account priya / tenderdesk (development only).
# TD_DEMO_USER=1
# Firebase project id for "Continue with Google" / SSO. Empty disables them.
# The browser part goes in frontend/.env.local (see frontend/.env.example).
TD_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------- company data
# Company data set (folder under backend/app/data/companies): datacare | meridian
TD_COMPANY=datacare

# ---------------------------------------------------------------- services
# Competitor market API. Empty uses the bundled mock in-process.
# TD_MARKET_API_URL=http://127.0.0.1:8100
TD_MARKET_API_KEY=demo-market-key
# live tries ECB (Frankfurter) and open.er-api.com, then the cache, then the reference table.
TD_FX_MODE=live
TD_PIPELINE_WORKERS=4

# ---------------------------------------------------------------- storage (optional)
# Database, trained models and generated documents; default backend/var/<company>.
# TD_VAR_DIR=/absolute/path/to/var
# Any SQLAlchemy URL; default SQLite in the var folder.
# TD_DATABASE_URL=postgresql+psycopg://user:pass@localhost/tenderdesk
