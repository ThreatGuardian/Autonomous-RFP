# Environment variables read by the backend (all optional; defaults shown).
# Export them in your shell before starting the server.

# Where the SQLite database, trained models and generated PDFs are stored.
TD_VAR_DIR=backend/var
# Any SQLAlchemy URL; defaults to SQLite inside TD_VAR_DIR.
# TD_DATABASE_URL=postgresql+psycopg://user:pass@localhost/tenderdesk

# Competitor market API. Leave empty to call the bundled mock in-process, or run it
# as a separate service:  uvicorn app.market.service:market_app --port 8100
# TD_MARKET_API_URL=http://127.0.0.1:8100
TD_MARKET_API_KEY=demo-market-key

# Currency: "live" tries ECB (Frankfurter) and open.er-api.com, then the cache,
# then the reference table. "offline" skips the network.
TD_FX_MODE=live
TD_FX_CACHE_TTL_HOURS=12

# Number of requests processed in parallel.
TD_PIPELINE_WORKERS=4
